{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "luadoc",
      "camelcase": "Luadoc",
      "title": "Luadoc",
      "scope": "source.luadoc",
      "file-types": [
        "luadoc"
      ],
      "injection-regex": "^luadoc$",
      "class-name": "TreeSitterLuadoc"
    }
  ],
  "metadata": {
    "version": "1.1.0",
    "license": "MIT",
    "description": "Luadoc grammar for tree-sitter",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-luadoc.git",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}